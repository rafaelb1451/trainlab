# Copie para .env e preencha. O .env NAO vai para o git.
# Gere os segredos com:  openssl rand -base64 48

# ---------- dominio e HTTPS ----------
APP_DOMAIN=app.seudominio.com
ACME_EMAIL=voce@seudominio.com
APP_BASE_URL=https://app.seudominio.com

# ---------- banco ----------
POSTGRES_DB=trainlab
POSTGRES_USER=trainlab
POSTGRES_PASSWORD=troque-esta-senha

# ---------- segredos da aplicacao (obrigatorios) ----------
# Sem JWT_SECRET o servidor gera chave aleatoria por execucao e as sessoes
# caem a cada deploy. Sem INTEGRATION_SECRET as credenciais de integracao
# nao podem ser decifradas depois de um restart.
JWT_SECRET=
INTEGRATION_SECRET=

# ---------- primeiro treinador ----------
# Cria a conta SO' se ainda nao existir nenhum treinador. Depois do primeiro
# deploy, apague estas duas linhas.
BOOTSTRAP_COACH_EMAIL=voce@seudominio.com
BOOTSTRAP_COACH_PASSWORD=
BOOTSTRAP_COACH_NAME=Seu Nome

# ---------- e-mail ----------
MAIL_TRANSPORT=smtp
SPRING_MAIL_HOST=smtp.resend.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=resend
SPRING_MAIL_PASSWORD=re_sua_chave
MAIL_FROM=no-reply@seudominio.com
